name: Publish BLACKOUT PROTOCOL (vendored dependencies)
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Install pinned Three.js
        run: npm install --no-audit --no-fund
      - name: Vendor libraries and verify files
        run: npm run build
      - name: Assemble deployable site without build tools
        run: |
          mkdir -p dist
          cp index.html blue.glb mantaray-XHD.glb blackoutprotocol.jpg blackoutprotocol.mp3 dist/
          cp -a vendor dist/vendor
      - name: Upload complete static website
        uses: actions/upload-pages-artifact@v3
        with:
          path: dist
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
